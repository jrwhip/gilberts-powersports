{
  "name": "gilberts-powersports",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "cd public && python3 -m http.server 8000",
    "serve-alt": "cd public && php -S localhost:8000",
    "build-css": "postcss src/styles.css -o public/styles.css",
    "build-css:watch": "postcss src/styles.css -o public/styles.css --watch"
  },
  "browserslist": "defaults, not ie <= 11",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.17"
  }
}
